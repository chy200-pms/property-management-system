# ============================================================
#  Git 忽略规则
#  目的：推到 GitHub 部署到免费平台时，不要把构建产物、密钥、临时文件带上去
# ============================================================

# ---------- 构建产物 ----------
# jar 由平台在容器里现场编译（backend/Dockerfile.paas），不需要提交
backend/target/
*.jar.original

# ---------- 密钥 / 环境变量（重要）----------
# 这两个文件里有数据库密码和 JWT 密钥，一旦提交到公开仓库等于把口令送人
.env
deploy/.env
deploy/certs/

# ---------- Python ----------
__pycache__/
*.pyc

# ---------- Node（如果装了测试依赖）----------
node_modules/

# ---------- 临时验证脚本 ----------
.tmp-*

# ---------- 编辑器 / 操作系统 ----------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
Desktop.ini

# 数据库脚本的临时备份，不入库
*.bak
