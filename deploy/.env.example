# ============================================================
#  部署环境变量模板
#
#  用法：复制为项目根目录的 .env（deploy.sh 会自动生成并填入随机值）
#       cp deploy/.env.example .env
#
#  注意：.env 含密码，不要提交到代码仓库（已在 .gitignore 中忽略）
# ============================================================

# ---------- 数据库 ----------
# MySQL root 密码。容器首次启动时会用它初始化数据库。
# 改了这个值之后，如果数据卷已经建好，需要先 docker compose down -v 才会生效。
MYSQL_ROOT_PASSWORD=请改成你自己的强密码

# ---------- 安全 ----------
# JWT 签名密钥：至少 32 位随机串。上线前必须换掉默认值。
# 生成方式： openssl rand -base64 48
JWT_SECRET=请替换为至少32位的随机字符串

# 验证码答案回显策略：
#   false — 永不回显（生产环境，保持这个）
#   local — 仅回显给本机回环请求（想在服务器上跑自动化测试时临时用）
#   true  — 总是回显（仅本地排障，绝不可用于公网）
CAPTCHA_ECHO_MODE=false

# ---------- 访问端口 ----------
# 前端对外端口。用 80 直接 IP 访问；80 被占用（如已有宝塔/Nginx）则改成 8081 等
HTTP_PORT=80
